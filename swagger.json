  "info": {
    "title": "🚆✈️ Tiket App API",
    "description": "## Backend Pemesanan Tiket Kereta & Pesawat\n      \n**4 Role:** Admin · Petugas Kereta · Petugas Pesawat · User\n\n### Cara menggunakan:\n1. Login via `POST /api/auth/login`\n2. Copy token dari response\n3. Klik tombol **Authorize** di atas → paste token\n4. Semua endpoint bertanda 🔒 sudah terautentikasi",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "🔑 Auth",
      "description": "Login & profil"
    },
    {
      "name": "👑 Admin",
      "description": "Manajemen user, saldo, semua order"
    },
    {
      "name": "🛤️ Rute Perjalanan",
      "description": "CRUD rute kereta & pesawat"
    },
    {
      "name": "📅 Jadwal",
      "description": "CRUD jadwal + auto-generate kursi"
    },
    {
      "name": "🎟️ Tiket",
      "description": "Manajemen tiket & peta kursi"
    },
    {
      "name": "🛒 Pemesanan",
      "description": "Beli & refund tiket"
    },
    {
      "name": "👤 Fitur User",
      "description": "Saldo, transaksi, CS, cari tiket"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "rudi123"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "petugas_kereta",
              "petugas_pesawat",
              "user"
            ],
            "example": "user"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nama Baru"
          },
          "email": {
            "type": "string",
            "example": "email@baru.com"
          },
          "phone": {
            "type": "string",
            "example": "08211111999"
          },
          "current_password": {
            "type": "string",
            "example": "passwordLama123"
          },
          "new_password": {
            "type": "string",
            "example": "passwordBaru123"
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bayu Stang"
          },
          "username": {
            "type": "string",
            "example": "bayustang"
          },
          "email": {
            "type": "string",
            "example": "bayu@stang.com"
          },
          "phone": {
            "type": "string",
            "example": "081234567890"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "name",
          "username",
          "email",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nama Lengkap"
          },
          "username": {
            "type": "string",
            "example": "username123"
          },
          "email": {
            "type": "string",
            "example": "email@gmail.com"
          },
          "phone": {
            "type": "string",
            "example": "08211111111"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "petugas_kereta",
              "petugas_pesawat",
              "user"
            ]
          }
        },
        "required": [
          "name",
          "username",
          "email",
          "password",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "petugas_kereta",
              "petugas_pesawat",
              "user"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "TopupDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "example": 500000
          },
          "description": {
            "type": "string",
            "example": "Top-up via transfer BCA"
          }
        },
        "required": [
          "amount"
        ]
      },
      "CreateRouteDto": {
        "type": "object",
        "properties": {
          "transportType": {
            "type": "string",
            "enum": [
              "kereta",
              "pesawat"
            ]
          },
          "origin": {
            "type": "string",
            "example": "Malang"
          },
          "destination": {
            "type": "string",
            "example": "Surabaya"
          },
          "originCode": {
            "type": "string",
            "example": "ML"
          },
          "destinationCode": {
            "type": "string",
            "example": "SB"
          },
          "distanceKm": {
            "type": "number",
            "example": 89
          }
        },
        "required": [
          "transportType",
          "origin",
          "destination"
        ]
      },
      "UpdateRouteDto": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "originCode": {
            "type": "string"
          },
          "destinationCode": {
            "type": "string"
          },
          "distanceKm": {
            "type": "number"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreateScheduleDto": {
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string",
            "example": "uuid-route-id"
          },
          "vehicleName": {
            "type": "string",
            "example": "Argo Bromo Anggrek"
          },
          "vehicleCode": {
            "type": "string",
            "example": "KA-001"
          },
          "departureTime": {
            "type": "string",
            "example": "2025-12-25T08:00:00Z"
          },
          "arrivalTime": {
            "type": "string",
            "example": "2025-12-25T20:00:00Z"
          },
          "totalSeatsEconomy": {
            "type": "number",
            "example": 60,
            "default": 0
          },
          "totalSeatsVip": {
            "type": "number",
            "example": 20,
            "default": 0
          },
          "totalSeatsExecutive": {
            "type": "number",
            "example": 10,
            "default": 0
          },
          "priceEconomy": {
            "type": "number",
            "example": 200000
          },
          "priceVip": {
            "type": "number",
            "example": 350000
          },
          "priceExecutive": {
            "type": "number",
            "example": 600000
          }
        },
        "required": [
          "routeId",
          "vehicleName",
          "departureTime",
          "arrivalTime"
        ]
      },
      "UpdateScheduleDto": {
        "type": "object",
        "properties": {
          "vehicleName": {
            "type": "string"
          },
          "vehicleCode": {
            "type": "string"
          },
          "departureTime": {
            "type": "string"
          },
          "arrivalTime": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "boarding",
              "departed",
              "arrived",
              "cancelled"
            ]
          }
        }
      },
      "DelayGateDto": {
        "type": "object",
        "properties": {
          "delayMinutes": {
            "type": "string",
            "example": "Terlambat 15 Menit"
          },
          "gateNumber": {
            "type": "string",
            "example": "Gate 2B"
          },
          "flightStatus": {
            "type": "string",
            "example": "Boarding Now"
          }
        }
      },
      "CreateShiftLogDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Handover shift malam, manifest aman."
          },
          "status": {
            "type": "string",
            "example": "Normal",
            "enum": [
              "Normal",
              "Delay",
              "Overweight",
              "Maintenance"
            ]
          }
        },
        "required": [
          "text",
          "status"
        ]
      }
    }
  }
}